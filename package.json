{
  "name": "dsh-progress-report",
  "version": "0.5.0",
  "description": "Make a DSH agent report progress on long tasks: a host-side timer injects a one-line progress notice after N minutes or M tool calls. Zero dependencies, settings page, trigger log.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "progress",
    "report",
    "status",
    "long-running"
  ],
  "license": "MIT",
  "author": "rabbitRa-git",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rabbitRa-git/dsh-progress-report.git"
  },
  "homepage": "https://github.com/rabbitRa-git/dsh-progress-report#readme",
  "bugs": {
    "url": "https://github.com/rabbitRa-git/dsh-progress-report/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:clean": "node test/cleanroom.mjs",
    "check": "node --check lib/index.js && node --check client.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
